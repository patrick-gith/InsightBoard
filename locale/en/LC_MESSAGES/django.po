#: InsightApp/templates/pdf/report.html:328
#: ProjectInsight/templates/dashboard/dashboard.html:360
msgid "Comment ces résultats ont-ils été calculés ?"
msgstr "How were these results calculated?"

#: InsightApp/templates/pdf/report.html:331
msgid ""
"<strong>Chiffre d'affaires</strong> : somme de <code>quantité × prix "
"unitaire</code> sur l'ensemble des lignes. Si la quantité est absente, le "
"montant de chaque ligne est considéré comme un total déjà calculé."
msgstr ""
"<strong>Revenue</strong>: sum of <code>quantity × unit price</code> across "
"all rows. If quantity is missing, each row's amount is treated as an "
"already-computed total."

#: InsightApp/templates/pdf/report.html:334
msgid ""
"<strong>Panier moyen</strong> : chiffre d'affaires total divisé par le "
"nombre de lignes analysées."
msgstr ""
"<strong>Average order</strong>: total revenue divided by the number of "
"analyzed rows."

#: InsightApp/templates/pdf/report.html:337
msgid ""
"<strong>Quantité totale</strong> : somme de la colonne quantité sur toutes "
"les lignes valides."
msgstr ""
"<strong>Total quantity</strong>: sum of the quantity column across all "
"valid rows."

#: InsightApp/templates/pdf/report.html:340
msgid ""
"<strong>Produit le plus vendu</strong> : produit apparaissant le plus "
"fréquemment dans le fichier (en nombre de lignes, non pondéré)."
msgstr ""
"<strong>Best-selling product</strong>: product appearing most frequently in "
"the file (count of rows, unweighted)."

#: InsightApp/templates/pdf/report.html:343
msgid ""
"<strong>Ville principale</strong> : ville apparaissant le plus fréquemment "
"dans le fichier."
msgstr ""
"<strong>Top city</strong>: city appearing most frequently in the file."

#: InsightApp/templates/pdf/report.html:346
msgid ""
"<strong>Détection automatique</strong> : les colonnes sont identifiées par "
"correspondance de mots-clés (FR + EN), insensible à la casse. Aucune "
"configuration manuelle n'est requise."
msgstr ""
"<strong>Automatic detection</strong>: columns are identified by keyword "
"matching (FR + EN), case-insensitive. No manual configuration required."

#: InsightApp/templates/pdf/report.html:349
msgid ""
"<strong>Multiples</strong> : <code>k</code> = milliers, <code>M</code> = "
"millions, <code>G</code> = milliards. Les montants exacts restent affichés "
"en priorité."
msgstr ""
"<strong>Multiples</strong>: <code>k</code> = thousands, <code>M</code> = "
"millions, <code>G</code> = billions. Exact amounts always remain the "
"primary display."

#: InsightApp/templates/pdf/report.html:358
#: ProjectInsight/templates/dashboard/dashboard.html:436
msgid "Colonnes du fichier source"
msgstr "Source file columns"

#: InsightApp/templates/pdf/report.html:367
msgid ""
"Les colonnes surlignées en rouge ont été utilisées pour les calculs : "
"<code>date</code>, <code>amount</code>, <code>quantity</code>, "
"<code>product</code>, <code>city</code>, <code>revenue</code>."
msgstr ""
"Columns highlighted in red were used for calculations: <code>date</code>, "
"<code>amount</code>, <code>quantity</code>, <code>product</code>, "
"<code>city</code>, <code>revenue</code>."

